{
  "name": "spec-manager",
  "version": "0.4.3",
  "description": "spec-manager: local-first spec-driven development platform. Pure markdown storage, no network, no MCP. Portable CLI + multi-agent instructions.",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=18"
  },
  "bin": {
    "spec-manager": "dist/cli/index.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "scripts",
    "skill",
    "templates",
    "rules",
    "AGENTS.md",
    "CODEBUDDY.md",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc",
    "test": "vitest run",
    "test:watch": "vitest",
    "dev": "tsc --watch",
    "lint": "tsc --noEmit",
    "verify:installed-cli": "node scripts/verify-installed-cli.mjs"
  },
  "keywords": [
    "spec-driven",
    "spec",
    "methodology",
    "claude-code",
    "codex",
    "opencode",
    "codebuddy",
    "agents-md",
    "skill",
    "ai-coding",
    "agent",
    "delta-spec"
  ],
  "dependencies": {
    "@inquirer/prompts": "^7.10.1",
    "commander": "^12.0.0",
    "gray-matter": "^4.0.3",
    "yaml": "^2.4.0",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@types/node": "^20.12.0",
    "typescript": "^5.4.0",
    "vitest": "^1.6.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/loki-ai-ch/spec-manager.git"
  },
  "bugs": {
    "url": "https://github.com/loki-ai-ch/spec-manager/issues"
  },
  "author": "loki",
  "homepage": "https://github.com/loki-ai-ch/spec-manager"
}
